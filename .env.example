# Public site URL used for canonical links, sitemap, and JSON-LD.
# Set to the real production domain once it is assigned.
NEXT_PUBLIC_SITE_URL=https://island-horizons.vercel.app

# Telegram notifications for the consultation request form.
# Create a bot via @BotFather, then message it once and read
# https://api.telegram.org/bot<token>/getUpdates to find the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Analytics (optional — leave blank to disable).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_YANDEX_METRIKA_ID=
